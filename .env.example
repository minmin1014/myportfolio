# Public site URL, used for canonical/OGP/hreflang metadata
NEXT_PUBLIC_SITE_URL=https://minforge.dev

# SMTP credentials used by the /api/contact route (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me

# Sender/recipient for contact form emails
CONTACT_FROM_EMAIL=no-reply@minforge.dev
CONTACT_TO_EMAIL=contact@minforge.dev

# Local dev only: comma-separated extra origins allowed by `next dev`
# (e.g. a LAN or Tailscale IP used to reach the dev server cross-origin).
# Leave unset in production. Put the real value in .env.local (gitignored).
# DEV_ALLOWED_ORIGINS=192.0.2.10
